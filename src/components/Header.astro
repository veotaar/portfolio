---
interface Props {
	name: string;
	resumePath: string;
}

const { name, resumePath } = Astro.props;
const isAboutPage = Astro.url.pathname === "/about";
---

<header class="header">
	<nav class="header__nav container">
		<a href="/" class="header__logo" id="header-logo">{name}</a>
		<div class="header__actions">
			<a
				href="/about"
				class:list={[
					"btn",
					"btn-ghost",
					"header__about",
					isAboutPage && "header__about--active",
				]}
				data-track="about-click"
			>
				About
			</a>
			<a href={resumePath} target="_blank" rel="noopener noreferrer" class="btn btn-outline header__resume" data-track="resume-click">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
					<polyline points="14 2 14 8 20 8" />
					<line x1="16" y1="13" x2="8" y2="13" />
					<line x1="16" y1="17" x2="8" y2="17" />
					<polyline points="10 9 9 9 8 9" />
				</svg>
				Resume
			</a>
		</div>
	</nav>
</header>

<style>
	.header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		height: var(--header-height);
		background-color: rgba(10, 10, 10, 0.8);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.header__nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 100%;
	}

	.header__actions {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.header__logo {
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.header__about {
		padding-inline: 1rem;
	}

	.header__about--active {
		color: var(--text);
		/* background-color: var(--bg-surface); */
	}

	.header__resume svg {
		flex-shrink: 0;
	}

	@media (max-width: 640px) {
		.header__actions {
			gap: 0.5rem;
		}

		.header__about,
		.header__resume {
			padding-inline: 0.875rem;
		}
	}
</style>

<script>
	const logo = document.getElementById("header-logo");
	logo?.addEventListener("click", (e) => {
		if (window.location.pathname === "/") {
			e.preventDefault();
			window.scrollTo({ top: 0, behavior: "smooth" });
		}
	});
</script>
